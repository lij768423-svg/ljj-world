portfolio.example.com {
	encode zstd gzip

	header {
		-Server
		Cross-Origin-Opener-Policy "same-origin"
		Origin-Agent-Cluster "?1"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@immutable path_regexp immutable ^/assets/(.+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)|.+-[a-f0-9]{12}\.(webp|png|svg|avif))$
	handle /assets/* {
		root * /srv/portfolio/current
		@currentAsset file
		handle @currentAsset {
			route {
				header Cache-Control "public, max-age=3600, must-revalidate"
				header @immutable Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
		}
		handle {
			root * /srv/portfolio/shared
			@retainedAsset file
			handle @retainedAsset {
				header Cache-Control "public, max-age=31536000, immutable"
				file_server
			}
			handle {
				header Cache-Control "no-store"
				respond "" 404
			}
		}
	}
	handle {
		root * /srv/portfolio/current
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_text}" {err.status_code}
	}
}
